# sessiondeck configuration. Copy to .env and start with:  node --env-file=.env server.js
# (or point a systemd EnvironmentFile= at it, see deploy/sessiondeck.service)

# Required. There is no default password; sessiondeck refuses to start without one.
# At least 12 characters. Generate one with:  openssl rand -base64 24
SESSIONDECK_PASSWORD=

# Login name for the browser prompt.
SESSIONDECK_USER=admin

# Address and port of the web UI. Keep 127.0.0.1 and put a reverse proxy with HTTPS in front.
# Use 0.0.0.0 only on a trusted network: Basic auth over plain HTTP is readable on the wire.
SESSIONDECK_HOST=127.0.0.1
SESSIONDECK_PORT=8765

# Folder whose subfolders are offered as projects. Sessions can never start outside of it.
SESSIONDECK_ROOT=/home/youruser/projects

# One local port per session, counting up from here. ttyd always binds to 127.0.0.1.
SESSIONDECK_TTYD_PORT_START=9100

# Binaries, looked up in PATH unless absolute.
SESSIONDECK_TTYD_BIN=ttyd
SESSIONDECK_CLAUDE_BIN=claude

# Only when sessiondeck itself runs as root: the unprivileged user that owns the tmux
# sessions and runs Claude Code. Leave empty when running as a normal user (recommended).
SESSIONDECK_RUN_AS=

# Where session state is kept (sessions.json, activity.json). Default: ./data
SESSIONDECK_DATA_DIR=

# Where dropped images are stored before their path is typed into the prompt.
# Default: <data dir>/images, or ~<run-as user>/.cache/sessiondeck-images in root mode.
# Must be owned by the user sessiondeck runs as.
SESSIONDECK_UPLOAD_DIR=

# Display name of this server in the UI. Default: the host name.
SESSIONDECK_NAME=
